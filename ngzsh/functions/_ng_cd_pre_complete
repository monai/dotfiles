#compdef -p (cd|chdir|pushd)

emulate -L zsh

local provider
local saved_prefix="$PREFIX"
local saved_suffix="$SUFFIX"
local saved_iprefix="$IPREFIX"
local saved_isuffix="$ISUFFIX"
local saved_current="$CURRENT"
local saved_compskip="${_compskip-}"
local -a saved_words=( "$words[@]" )
integer had_compskip=$+_compskip
integer provider_status
integer completion_status=1

for provider in "${ng_cd_pre_completion_functions[@]}"; do
  (( $+functions[$provider] )) || autoload -Uz "$provider"

  "$provider"
  provider_status=$?

  PREFIX="$saved_prefix"
  SUFFIX="$saved_suffix"
  IPREFIX="$saved_iprefix"
  ISUFFIX="$saved_isuffix"
  CURRENT="$saved_current"
  words=( "$saved_words[@]" )
  if (( had_compskip )); then
    _compskip="$saved_compskip"
  else
    unset _compskip
  fi

  if (( provider_status == 0 )); then
    completion_status=0
  elif (( provider_status > 1 )); then
    return "$provider_status"
  fi
done

return "$completion_status"
