emulate -L zsh
setopt extendedglob

local buffer="${1-}"
integer max_length="${NG_SYNTAX_HIGHLIGHT_MAX_BUFFER_LENGTH:-20000}"

(( ${#buffer} <= max_length )) || return 0

local reserved_words=" always begin case coproc do done elif else end esac fi for foreach function if in nocorrect noglob repeat select then time until while "
local command_position_words=" always coproc do elif else if repeat then time until while "
local word candidate_path dir base category char next text
integer i=1 start end j depth escaped at_command=1 expecting_redirect_target=0 expecting_function_name=0 closed

while (( i <= ${#buffer} )); do
  char="${buffer[i]}"
  next="${buffer[i + 1]}"

  if [[ "$char" = [[:space:]] ]]; then
    (( ++i ))
    continue
  fi

  if [[ "$char" = "#" && -o interactive_comments ]]; then
    (( start = i - 1, end = ${#buffer} ))
    print -r -- "$start $end comment"
    return 0
  fi

  if [[ "$char$next${buffer[i + 2]}" = '$((' ]]; then
    (( start = i - 1, j = i + 3 ))
    while (( j <= ${#buffer} )); do
      if [[ "${buffer[j]}${buffer[j + 1]}" = '))' ]]; then
        (( j += 2 ))
        break
      fi
      (( ++j ))
    done
    (( end = j - 1 ))
    print -r -- "$start $end arithmetic-expansion"
    (( i = j ))
    at_command=0
    continue
  fi

  if [[ "$char$next" = '$(' ]]; then
    (( start = i - 1, j = i + 2, depth = 1 ))
    while (( j <= ${#buffer} && depth > 0 )); do
      if [[ "${buffer[j]}" = "\\" ]]; then
        (( j += 2 ))
        continue
      fi
      if [[ "${buffer[j]}${buffer[j + 1]}" = '$(' ]]; then
        (( ++depth, j += 2 ))
        continue
      fi
      if [[ "${buffer[j]}" = ")" ]]; then
        (( --depth ))
      fi
      (( ++j ))
    done
    (( end = j - 1 ))
    print -r -- "$start $end command-substitution"
    (( i = j ))
    at_command=0
    continue
  fi

  if [[ "$char$next" = '<(' || "$char$next" = '>(' || "$char$next" = '=(' ]]; then
    (( start = i - 1, j = i + 2, depth = 1 ))
    while (( j <= ${#buffer} && depth > 0 )); do
      if [[ "${buffer[j]}" = "\\" ]]; then
        (( j += 2 ))
        continue
      fi
      if [[ "${buffer[j]}" = "(" ]]; then
        (( ++depth ))
      elif [[ "${buffer[j]}" = ")" ]]; then
        (( --depth ))
      fi
      (( ++j ))
    done
    (( end = j - 1 ))
    print -r -- "$start $end process-substitution"
    (( i = j ))
    at_command=0
    continue
  fi

  if [[ "$char" = "'" ]]; then
    (( start = i - 1, j = i + 1, closed = 0 ))
    while (( j <= ${#buffer} )); do
      if [[ "${buffer[j]}" = "'" ]]; then
        if [[ "${buffer[j + 1]}" = "'" ]]; then
          (( j += 2 ))
          continue
        fi
        closed=1
        (( ++j ))
        break
      fi
      (( ++j ))
    done
    (( end = closed ? j - 1 : ${#buffer} ))
    print -r -- "$start $end $([[ $closed = 1 ]] && print string || print unclosed-string)"
    (( i = end + 1 ))
    at_command=0
    continue
  fi

  if [[ "$char" = '"' ]]; then
    (( start = i - 1, j = i + 1, closed = 0 ))
    while (( j <= ${#buffer} )); do
      if [[ "${buffer[j]}" = "\\" ]]; then
        (( j += 2 ))
        continue
      fi
      if [[ "${buffer[j]}" = '"' ]]; then
        closed=1
        (( ++j ))
        break
      fi
      (( ++j ))
    done
    (( end = closed ? j - 1 : ${#buffer} ))
    print -r -- "$start $end $([[ $closed = 1 ]] && print string || print unclosed-string)"
    integer k sub_start sub_end
    (( k = start + 2 ))
    while (( k < end )); do
      if [[ "${buffer[k]}${buffer[k + 1]}" = '$(' ]]; then
        (( sub_start = k - 1, j = k + 2, depth = 1 ))
        while (( j <= end && depth > 0 )); do
          if [[ "${buffer[j]}" = "\\" ]]; then
            (( j += 2 ))
            continue
          fi
          if [[ "${buffer[j]}${buffer[j + 1]}" = '$(' ]]; then
            (( ++depth, j += 2 ))
            continue
          fi
          if [[ "${buffer[j]}" = ")" ]]; then
            (( --depth ))
          fi
          (( ++j ))
        done
        (( sub_end = j - 1 ))
        print -r -- "$sub_start $sub_end command-substitution"
        (( k = j ))
        continue
      fi

      if [[ "${buffer[k]}" = '$' ]]; then
        if [[ "${buffer[k + 1]}" = "{" ]]; then
          (( sub_start = k - 1, j = k + 2 ))
          while (( j < end )) && [[ "${buffer[j]}" != "}" ]]; do
            (( ++j ))
          done
          (( j < end )) && (( ++j ))
          (( sub_end = j - 1 ))
          print -r -- "$sub_start $sub_end parameter-expansion"
          (( k = j ))
          continue
        elif [[ "${buffer[k + 1]}" = [A-Za-z0-9_@#\?\$\!] ]]; then
          (( sub_start = k - 1, j = k + 1 ))
          while (( j < end )) && [[ "${buffer[j]}" = [A-Za-z0-9_@#\?\$\!] ]]; do
            (( ++j ))
          done
          (( sub_end = j - 1 ))
          print -r -- "$sub_start $sub_end parameter-expansion"
          (( k = j ))
          continue
        fi
      fi

      (( ++k ))
    done
    (( i = end + 1 ))
    at_command=0
    continue
  fi

  if [[ "$char$next" = "&&" || "$char$next" = "||" || "$char$next" = "|&" ]]; then
    (( start = i - 1, end = i + 1 ))
    print -r -- "$start $end separator"
    (( i += 2 ))
    at_command=1
    expecting_redirect_target=0
    expecting_function_name=0
    continue
  fi

  if (( at_command )) && [[ "$char$next" = '()' ]]; then
    (( start = i - 1, end = i + 1 ))
    print -r -- "$start $end function"
    (( i += 2 ))
    at_command=1
    expecting_redirect_target=0
    expecting_function_name=0
    continue
  fi

  if [[ "$char" = [\;\|\&\(\)\{\}] ]]; then
    (( start = i - 1, end = i ))
    print -r -- "$start $end separator"
    (( ++i ))
    at_command=1
    expecting_redirect_target=0
    expecting_function_name=0
    continue
  fi

  if [[ "$char" = [0-9] ]]; then
    (( j = i ))
    while (( j <= ${#buffer} )) && [[ "${buffer[j]}" = [0-9] ]]; do
      (( ++j ))
    done

    if [[ "${buffer[j]}" = [\<\>] ]]; then
      (( start = i - 1, j++ ))
      while (( j <= ${#buffer} )) && [[ "${buffer[j]}" = [\<\>\&\|\!\-] ]]; do
        (( ++j ))
      done
      (( end = j - 1 ))
      print -r -- "$start $end redirection"
      (( i = j ))
      expecting_redirect_target=1
      expecting_function_name=0
      continue
    fi
  fi

  if [[ "$char" = [\<\>] ]]; then
    (( start = i - 1, j = i + 1 ))
    while (( j <= ${#buffer} )) && [[ "${buffer[j]}" = [\<\>\&\|\!\-] ]]; do
      (( ++j ))
    done
    (( end = j - 1 ))
    print -r -- "$start $end redirection"
    (( i = j ))
    expecting_redirect_target=1
    expecting_function_name=0
    continue
  fi

  (( start = i - 1, j = i ))
  while (( j <= ${#buffer} )); do
    char="${buffer[j]}"
    next="${buffer[j + 1]}"
    [[ "$char" = [[:space:]] || "$char" = [\;\|\&\<\>\(\)\{\}] || "$char" = [\'\"] ]] && break
    (( ++j ))
  done

  word="${buffer[i,j - 1]}"
  (( end = j - 1 ))

  if [[ "$word" =~ '^[A-Za-z_][A-Za-z0-9_]*(\[[^]]+\])?=' && $at_command = 1 ]]; then
    print -r -- "$start $end assignment"
    (( i = j ))
    continue
  fi

  text="$word"
  integer scan_start=$start
  while [[ "$text" =~ '(\$\{[^}]*\}|\$[A-Za-z_][A-Za-z0-9_]*|\$[0-9@#?$!])' ]]; do
    local before="${text%%$MATCH*}"
    (( start = scan_start + ${#before}, end = start + ${#MATCH} ))
    print -r -- "$start $end parameter-expansion"
    text="${text#*"$MATCH"}"
    (( scan_start = end ))
  done
  (( start = i - 1, end = j - 1 ))

  if (( expecting_function_name )); then
    print -r -- "$start $end function"
    at_command=0
    expecting_function_name=0
  elif (( at_command && ! expecting_redirect_target )); then
    if [[ "$reserved_words" = *" $word "* ]]; then
      category=reserved-word
      [[ "$word" = function ]] && expecting_function_name=1
    elif (( ${+aliases[$word]} )); then
      category=alias
    elif (( ${+builtins[$word]} )); then
      category=builtin
    elif (( ${+functions[$word]} )); then
      category=function
    elif [[ "$word" = */* ]]; then
      candidate_path="$word"
      [[ "$candidate_path" = "~" || "$candidate_path" = "~/"* ]] && candidate_path="${HOME}${candidate_path#\~}"
      [[ -x "$candidate_path" && ! -d "$candidate_path" ]] && category=command || category=unknown-command
    else
      integer lookahead=$j
      while (( lookahead <= ${#buffer} )) && [[ "${buffer[lookahead]}" = [[:space:]] ]]; do
        (( ++lookahead ))
      done
      if [[ "${buffer[lookahead]}${buffer[lookahead + 1]}" = '()' ]]; then
        category=function
        expecting_function_name=0
      elif (( ${+commands[$word]} )) || whence -p -- "$word" >/dev/null 2>&1; then
        category=command
      else
        category=unknown-command
      fi
    fi
    print -r -- "$start $end $category"
    [[ "$command_position_words" = *" $word "* ]] && at_command=1 || at_command=0
  else
    if [[ "$word" = --* || "$word" = -?* ]]; then
      print -r -- "$start $end option"
    elif [[ "$word" = *[\*\?\[\]]* || "$word" = *"("*")"* || "$word" = *\^* ]]; then
      print -r -- "$start $end glob"
    else
      candidate_path="$word"
      [[ "$candidate_path" = "~" || "$candidate_path" = "~/"* ]] && candidate_path="${HOME}${candidate_path#\~}"
      if (( ! expecting_redirect_target )) && [[ "$word" = *:*/* ]]; then
        print -r -- "$start $end volume-spec"
      elif (( expecting_redirect_target )) || [[ "$word" = */* || "$word" = .* || "$word" = "~"* || -e "$candidate_path" ]]; then
        if [[ -e "$candidate_path" ]]; then
          print -r -- "$start $end path"
        else
          dir="${candidate_path:h}"
          base="${candidate_path:t}"
          [[ "$dir" = "$candidate_path" ]] && dir=.
          local -a matches
          matches=( "${dir}/${base}"*(N) )
          if (( ${#matches} )); then
            print -r -- "$start $end path-prefix"
          else
            print -r -- "$start $end missing-path"
          fi
        fi
      elif [[ "$word" != -* ]]; then
        local -a plain_matches
        plain_matches=( "./${word}"*(N) )
        (( ${#plain_matches} )) && print -r -- "$start $end path-prefix"
      fi
    fi
    at_command=0
    expecting_redirect_target=0
  fi

  (( i = j ))
done
