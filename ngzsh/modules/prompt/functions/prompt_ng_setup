autoload -Uz vcs_info
autoload -Uz add-zsh-hook

zstyle ':vcs_info:git:*' check-for-changes true
zstyle ':vcs_info:git:*' stagedstr '%F{green}+%f'
zstyle ':vcs_info:git:*' unstagedstr '%F{yellow}*%f'
zstyle ':vcs_info:git:*' formats ' %F{cyan}%b%f%c%u'
zstyle ':vcs_info:git:*' actionformats ' %F{cyan}%b%f %F{yellow}(%a)%f%c%u'

typeset -g prompt_ng_git=''

prompt_ng_update_git() {
  vcs_info
  prompt_ng_git="${vcs_info_msg_0_}"

  [[ -z "$prompt_ng_git" ]] && return

  local ahead=0
  local behind=0

  read -r ahead behind < <(
    git rev-list --left-right --count HEAD...'@{upstream}' 2>/dev/null
  )

  (( ahead  > 0 )) && prompt_ng_git+=" %F{green}↑${ahead}%f"
  (( behind > 0 )) && prompt_ng_git+=" %F{red}↓${behind}%f"
}

prompt_ng_setup() {
  prompt_opts=(cr sp percent subst)

  local prompt_rule='%F{240}${(l:$(( COLUMNS - 1 ))::─:)}%f'
  local prompt_path='%F{blue}%~%f'
  local prompt_symbol='%F{white}%#%f'
  local prompt_keymap='%F{240}[${editor_info[keymap]}]%f'

  PROMPT="${prompt_rule}"$'\n'
  PROMPT+="${prompt_path}"'${prompt_ng_git}'
  PROMPT+=" ${prompt_symbol} ${prompt_keymap} "
}

prompt_ng_preview() {
  ng-editor-info 2> /dev/null
  prompt_ng_update_git

  prompt_preview_theme ng
}

TRAPWINCH() {
  zle reset-prompt 2> /dev/null
}

add-zsh-hook precmd prompt_ng_update_git

prompt_ng_setup "$@"
